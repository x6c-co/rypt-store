# Copy to .env next to docker-compose.yml. Every value is optional.

# The image tag to run: main (the default) follows the main branch; a release
# such as 0.1.0, or sha-<commit>, pins one build.
# RYPT_STORE_IMAGE_TAG=main

# rypt.dev: an API token and the key ID from the rypt.dev dashboard. With
# both set the rypt provider loads; set RYPT_STORE_KEYS_PROVIDER=rypt to
# wrap new keys there, then run `rypt-store keys migrate --to rypt` to move
# existing ones.
RYPT_STORE_RYPT_TOKEN=
RYPT_STORE_RYPT_KEY_ID=
# RYPT_STORE_KEYS_PROVIDER=rypt

# ACME (Let's Encrypt): with both set, the server obtains a certificate for
# the domains (comma-separated). Ports 80 and 443 must reach this host.
RYPT_STORE_TLS_DOMAINS=
RYPT_STORE_TLS_ACME_EMAIL=
# RYPT_STORE_SERVER_PUBLIC_URL=https://secrets.example.com

# DNS-01 instead of HTTP-01, for example with Cloudflare:
# RYPT_STORE_TLS_ACME_CHALLENGE=dns
# RYPT_STORE_TLS_ACME_DNS_PROVIDER=cloudflare
# CLOUDFLARE_API_TOKEN=
